# ============================
# Spring
# ============================
SPRING_PROFILES_ACTIVE=dev

# ============================
# JWT
# ============================
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=259200000

# ============================
# Kakao OIDC
# ============================
KAKAO_NATIVE_APP_KEY=
KAKAO_ISS=
KAKAO_JWKS_URL=
KAKAO_ADMIN_KEY=

# ============================
# Apple OAuth / OIDC
# ============================
APPLE_ISS=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TOKEN_URL=https://appleid.apple.com/auth/token
APPLE_REVOKE_URL=https://appleid.apple.com/auth/revoke

# ============================
# Google OIDC
# ============================
GOOGLE_ISS=https://accounts.google.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ============================
# Auth Provider Token
# ============================
AUTH_PROVIDER_TOKEN_ENCRYPTION_KEY=

# ============================
# Firebase
# ============================
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# ============================
# Post-meal Notification
# ============================
POST_MEAL_NOTIFICATION_DELAY=PT2H
POST_MEAL_NOTIFICATION_QUIET_HOURS_START=22:00
POST_MEAL_NOTIFICATION_DEFERRED_TIME=09:00
POST_MEAL_NOTIFICATION_COOLDOWN=PT90M

# ============================
# Weekly Report
# ============================
WEEKLY_REPORT_GENERATION_CRON=0 0 10 * * MON
WEEKLY_REPORT_NOTIFICATION_CRON=-

# ============================
# Sentry
# ============================
SENTRY_DSN=

# ============================
# Better Stack (OTLP metrics)
# ============================
BETTERSTACK_OTLP_URL=
BETTERSTACK_SOURCE_TOKEN=
